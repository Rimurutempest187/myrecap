# Production edge behind Cloudflare (orange-cloud proxy, SSL mode "Full (strict)").
# TLS uses a Cloudflare Origin Certificate (deploy/certs/origin.pem + origin.key), so no Let's Encrypt is needed
# and the origin only ever talks to Cloudflare.
{
	admin off
	auto_https disable_redirects
	servers {
		# Cloudflare edge ranges — trust their X-Forwarded-For / CF-Connecting-IP
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$DOMAIN} {
	tls /certs/origin.pem /certs/origin.key
	encode zstd gzip

	request_body {
		max_size 110MB
	}

	# `route` keeps these in order: block non-Cloudflare traffic first, then dispatch.
	route {
		# Only Cloudflare may reach the origin (stops direct-IP access that would bypass Cloudflare).
		# ORIGIN_ALLOW_EXTRA can add more ranges (e.g. your office IP) — space separated.
		@notCloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 {$ORIGIN_ALLOW_EXTRA:127.0.0.1/32}
		respond @notCloudflare "Forbidden — please use https://{host}" 403

		@api path /api/* /metrics
		handle @api {
			reverse_proxy api:4000 {
				header_up X-Forwarded-For {client_ip}
				flush_interval -1
				transport http {
					read_timeout 15m
					write_timeout 15m
				}
			}
		}
		handle {
			reverse_proxy web:3000
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output stdout
		format json
	}
}

# Plain HTTP → HTTPS (Cloudflare normally upgrades before reaching us)
http://{$DOMAIN} {
	redir https://{host}{uri} permanent
}
