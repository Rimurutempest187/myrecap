# Production edge: automatic HTTPS for {$DOMAIN}. /api/* streams straight to the API service
# (large uploads in local-storage mode, SSE progress), everything else goes to Next.js.
{$DOMAIN:localhost} {
	encode {
		zstd
		gzip
		# never compress Server-Sent Events: compression buffers them until the stream ends
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}
	request_body {
		max_size 2GB
	}
	@api path /api/* /metrics
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:4000} {
			flush_interval -1
			transport http {
				read_timeout 15m
				write_timeout 15m
			}
		}
	}
	handle {
		reverse_proxy {$WEB_UPSTREAM:web:3000}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output stdout
		format json
	}
}
