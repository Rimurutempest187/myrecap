# =====================================================================
# RecapAI configuration. Copy to .env and fill in. NEVER commit .env.
# =====================================================================

# ---- Core -----------------------------------------------------------
NODE_ENV=production
DOMAIN=recap.example.com                     # Caddy obtains HTTPS certs for this domain
WEB_ORIGIN=https://recap.example.com         # comma-separated list of allowed browser origins
API_PUBLIC_URL=https://recap.example.com     # public base URL (used for local-storage signed links)
SESSION_SECRET=change-me-to-64-random-hex-chars   # openssl rand -hex 32
SESSION_TTL_DAYS=30
COOKIE_SECURE=true
LOG_LEVEL=info
METRICS_TOKEN=change-me                      # Bearer token for GET /metrics (Prometheus)

# ---- Database / queue (docker-compose builds the URLs from these) ---
POSTGRES_USER=recap
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=recap
REDIS_PASSWORD=change-me-strong-redis-password
# For non-compose deployments set these directly:
# DATABASE_URL=postgresql://recap:pw@host:5432/recap?schema=public
# REDIS_URL=redis://:pw@host:6379

# ---- First admin (created by the seed on first start) ---------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
SIGNUP_BONUS_CREDITS=30

# ---- Storage: Cloudflare R2 (S3-compatible, private bucket) ---------
STORAGE_DRIVER=r2                  # r2 | s3 | local (local = dev only)
R2_ACCOUNT_ID=your-cloudflare-account-id
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
S3_BUCKET=recapai-media
S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # optional override (also for MinIO/AWS)
SIGNED_URL_TTL_SEC=3600

# ---- Upload limits (hard ceilings; plans can be lower) --------------
MAX_UPLOAD_MB=2048
MAX_VIDEO_MINUTES=180
ALLOWED_VIDEO_MIME=video/mp4,video/quicktime,video/x-matroska,video/webm,video/x-msvideo

# ---- AI: any OpenAI-compatible Chat Completions API with vision -----
# OpenAI: https://api.openai.com/v1 · Gemini: https://generativelanguage.googleapis.com/v1beta/openai
# OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini              # script writing (must write good Burmese)
VISION_MODEL=gpt-4o-mini           # frame analysis (must accept images)
LLM_INPUT_USD_PER_1M=0.15          # used for cost tracking
LLM_OUTPUT_USD_PER_1M=0.60
ANALYSIS_MAX_FRAMES=48
ANALYSIS_FRAMES_PER_CALL=16
SCENE_THRESHOLD=0.32

# ---- Optional: speech-to-text of original dialogue (Whisper API) ----
# Improves plot understanding for dialogue-heavy videos.
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=sk-...
# STT_MODEL=whisper-1

# ---- Myanmar voiceover: Microsoft Azure AI Speech (verified my-MM) --
# Voices: my-MM-NilarNeural (female), my-MM-ThihaNeural (male)
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=southeastasia
TTS_USD_PER_1M_CHARS=16

# ---- Worker / FFmpeg -------------------------------------------------
WORKER_CONCURRENCY=1               # renders per worker container; scale containers instead
WORKER_CPUS=2
WORKER_MEMORY=3g
FFMPEG_PRESET=veryfast
FFMPEG_THREADS=0
JOB_TIMEOUT_MIN=60
SUBTITLE_FONT=Noto Sans Myanmar
TEMP_RETENTION_HOURS=6
DELETED_PROJECT_PURGE_DAYS=7
RENDER_USD_PER_MIN=0.01

# ---- Payments: Stripe ------------------------------------------------
# Create Products/Prices in Stripe, then paste price IDs in Admin → Plans & limits
# (or set STRIPE_PRICE_CREATOR / STRIPE_PRICE_PRO before the first seed).
# Webhook endpoint: https://<domain>/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.*, invoice.paid, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_CREATOR=price_...
# STRIPE_PRICE_PRO=price_...

# ---- Backups ---------------------------------------------------------
BACKUP_ENABLED=true                # nightly pg_dump → R2 backups/db/
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=14
